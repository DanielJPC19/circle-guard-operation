pipeline {
    agent any

    options {
        timeout(time: 60, unit: 'MINUTES')
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    parameters {
        string(name: 'IMAGE_TAG',   defaultValue: 'prod-latest', description: 'Image tag a desplegar (ej: prod-a3f9c12)')
        string(name: 'ENVIRONMENT', defaultValue: 'production',  description: 'Ambiente destino')
    }

    environment {
        AKS_RG           = 'circleguard-prod-rg'
        AKS_CLUSTER      = 'circleguard-prod'
        ACR_REGISTRY     = 'cgregicesi.azurecr.io'
        NAMESPACE        = 'circleguard-prod'
        K8S_DIR          = 'k8s/services/prod'
        INFRA_DIR        = 'k8s/infra'
        SERVICES         = 'auth-service identity-service promotion-service gateway-service notification-service form-service'
        ROLLOUT_TIMEOUT  = '600'
        AZ_TENANT_ID     = credentials('az-tenant-id')
    }

    stages {

        // ── Stage 1: Autenticar en Azure y configurar kubectl ───────────────────
        stage('Azure Auth & Kubectl Config') {
            steps {
                withCredentials([usernamePassword(
                    credentialsId: 'azure-sp-credentials',
                    usernameVariable: 'AZ_CLIENT_ID',
                    passwordVariable: 'AZ_CLIENT_SECRET'
                )]) {
                    sh '''
                        az login --service-principal \
                            -u $AZ_CLIENT_ID \
                            -p $AZ_CLIENT_SECRET \
                            --tenant $AZ_TENANT_ID

                        az aks get-credentials \
                            --resource-group $AKS_RG \
                            --name $AKS_CLUSTER \
                            --overwrite-existing

                        echo "==> Verificando conexión al cluster de producción..."
                        kubectl config current-context
                        kubectl get nodes
                    '''
                }
            }
        }

        // ── Stage 2: Crear/verificar namespace + instalar addons ───────────────
        stage('Create Namespace') {
            steps {
                sh '''
                    echo "==> Creando namespace $NAMESPACE si no existe (idempotente)..."
                    kubectl create namespace $NAMESPACE --dry-run=client -o yaml | kubectl apply -f -
                    kubectl apply -f k8s/namespaces/circleguard-prod.yml

                    echo "==> Eliminando pods en Terminating state (bloqueados de runs anteriores)..."
                    TERMINATING=$(kubectl get pods -n $NAMESPACE --no-headers 2>/dev/null \
                        | awk '/Terminating/{print $1}' || true)
                    if [ -n "$TERMINATING" ]; then
                        echo "==> Pods Terminating encontrados: $TERMINATING"
                        echo "$TERMINATING" | xargs kubectl delete pod -n $NAMESPACE \
                            --force --grace-period=0 2>/dev/null || true
                        sleep 10
                    else
                        echo "==> No hay pods Terminating — OK"
                    fi

                    echo "==> Limpiando pods Pending de runs anteriores fallidos..."
                    kubectl delete pods -n $NAMESPACE --field-selector=status.phase=Pending --ignore-not-found=true 2>/dev/null || true
                    echo "==> Limpiando ReplicaSets viejos con 0 réplicas..."
                    OLD_RS=$(kubectl get rs -n $NAMESPACE -o jsonpath='{.items[?(@.spec.replicas==0)].metadata.name}' 2>/dev/null || true)
                    if [ -n "$OLD_RS" ]; then
                        kubectl delete replicaset -n $NAMESPACE $OLD_RS --ignore-not-found=true 2>/dev/null || true
                    fi

                    echo "==> Instalando cert-manager si no está presente..."
                    if ! helm status cert-manager -n cert-manager >/dev/null 2>&1; then
                        helm repo add jetstack https://charts.jetstack.io --force-update
                        helm install cert-manager jetstack/cert-manager \
                            --namespace cert-manager \
                            --create-namespace \
                            --version v1.15.5 \
                            --set installCRDs=true \
                            --wait --timeout 300s
                    else
                        echo "==> cert-manager ya está instalado — skipping"
                    fi

                    echo "==> Instalando sealed-secrets si no está presente..."
                    if ! helm status sealed-secrets -n kube-system >/dev/null 2>&1; then
                        helm repo add sealed-secrets https://bitnami-labs.github.io/sealed-secrets --force-update
                        helm install sealed-secrets sealed-secrets/sealed-secrets \
                            --namespace kube-system \
                            --version 2.15.4 \
                            --wait --timeout 300s
                    else
                        echo "==> sealed-secrets ya está instalado — skipping"
                    fi

                    echo "==> Diagnóstico de capacidad del nodo..."
                    kubectl describe node | grep -E "Taints:|pods:" | head -5 || true
                    echo "==> Total pods en el cluster:"
                    kubectl get pods -A --no-headers | wc -l

                    echo "==> Namespace $NAMESPACE listo"
                '''
            }
        }

        // ── Stage 3: Desplegar middleware ────────────────────────────────────────
        stage('Deploy Infrastructure (Middleware)') {
            steps {
                sh '''
                    echo "==> Aplicando manifiestos de infraestructura en $NAMESPACE..."
                    kubectl apply -f $INFRA_DIR/ -n $NAMESPACE

                    echo "==> Esperando que Postgres esté listo..."
                    kubectl rollout status statefulset/postgres -n $NAMESPACE --timeout=180s

                    echo "==> Esperando que Redis esté listo..."
                    kubectl rollout status deployment/redis -n $NAMESPACE --timeout=60s

                    echo "==> Esperando que Kafka Zookeeper esté listo..."
                    kubectl rollout status deployment/kafka-zookeeper -n $NAMESPACE --timeout=120s

                    echo "==> Esperando que Kafka Broker esté listo..."
                    kubectl rollout status deployment/kafka-broker -n $NAMESPACE --timeout=180s

                    echo "==> Esperando que Neo4j esté listo..."
                    kubectl rollout status deployment/neo4j -n $NAMESPACE --timeout=180s

                    echo "==> Esperando que OpenLDAP esté listo..."
                    kubectl rollout status deployment/openldap -n $NAMESPACE --timeout=60s

                    echo "==> Middleware listo en $NAMESPACE"
                '''
            }
        }

        // ── Stage 3.5: Inicializar bases de datos ────────────────────────────────
        stage('Init Databases') {
            steps {
                sh '''
                    echo "==> Creando bases de datos si no existen..."
                    for DB in circleguard_auth circleguard_identity circleguard_form circleguard_promotion circleguard_gateway; do
                        EXISTS=$(kubectl exec -n $NAMESPACE postgres-0 -- \
                            psql -U admin -d postgres -tAc \
                            "SELECT 1 FROM pg_database WHERE datname = '$DB'" 2>/dev/null || true)
                        if [ "$EXISTS" = "1" ]; then
                            echo "==> DB $DB ya existe — skipping"
                        else
                            kubectl exec -n $NAMESPACE postgres-0 -- \
                                psql -U admin -d postgres -c "CREATE DATABASE $DB;"
                            echo "==> DB $DB creada"
                        fi
                    done
                    echo "==> Init Databases completado"
                '''
            }
        }

        // ── Stage 4: Aplicar ConfigMaps ──────────────────────────────────────────
        stage('Apply ConfigMaps') {
            steps {
                sh 'kubectl apply -f k8s/configmaps/configmap-infra-prod.yml'
            }
        }

        // ── Stage 5: Crear Secret de aplicación ─────────────────────────────────
        stage('Apply Secrets') {
            steps {
                sh '''
                    kubectl create secret generic circleguard-secret \
                        -n $NAMESPACE \
                        --from-literal=POSTGRES_PASSWORD=password \
                        --from-literal=NEO4J_PASSWORD=password \
                        --from-literal=JWT_SECRET=circleguard-demo-jwt-secret-key-for-dev \
                        --from-literal=QR_SECRET=circleguard-demo-qr-secret-key-prod \
                        --from-literal=VAULT_SECRET=circleguard-demo-vault-secret-prod \
                        --from-literal=VAULT_SALT=deadbeef \
                        --from-literal=VAULT_HASH_SALT=circleguard-demo-vault-hash-salt \
                        --from-literal=LDAP_MANAGER_PASSWORD=password \
                        --dry-run=client -o yaml | kubectl apply -f -
                    echo "==> Secret circleguard-secret aplicado"
                '''
            }
        }

        // ── Stage 6: Validar manifests (server-side) ────────────────────────────
        stage('Validate Manifests (dry-run)') {
            steps {
                sh '''
                    echo "==> Validando manifiestos para producción (namespace: $NAMESPACE)..."
                    kubectl apply -f $K8S_DIR/all-services.yml \
                        --dry-run=server \
                        --namespace=$NAMESPACE
                    echo "==> Validación exitosa"
                '''
            }
        }

        // ── Stage 7: Actualizar image tags ───────────────────────────────────────
        stage('Update Image Tags') {
            steps {
                sh '''
                    for SERVICE in $SERVICES; do
                        bash scripts/update-image-tag.sh $SERVICE $IMAGE_TAG prod
                    done
                    echo "==> Image tags actualizados a $IMAGE_TAG en $K8S_DIR/all-services.yml"
                '''
            }
        }

        // ── Stage 8: Desplegar servicios ─────────────────────────────────────────
        stage('Deploy Services') {
            steps {
                sh '''
                    echo "==> Desplegando servicios en $NAMESPACE con tag $IMAGE_TAG..."
                    kubectl apply -f $K8S_DIR/all-services.yml -n $NAMESPACE
                    kubectl apply -f $K8S_DIR/ingress.yml -n $NAMESPACE
                    kubectl apply -f k8s/cert-manager/clusterissuer.yml
                    if kubectl get crd virtualservices.networking.istio.io 2>/dev/null; then
                        echo "==> Aplicando configuración Istio..."
                        kubectl apply -f istio/peer-authentication.yml
                        kubectl apply -f istio/destination-rules.yml
                        kubectl apply -f istio/virtual-services.yml
                    else
                        echo "==> Istio no instalado — skipping Istio configs"
                    fi
                '''
            }
        }

        // ── Stage 9: Verificar rollout + auto-rollback (paralelo) ───────────────
        stage('Rollout Verification') {
            steps {
                script {
                    def servicesList = env.SERVICES.tokenize(' ')
                    def branches = [:]

                    servicesList.each { svcName ->
                        def svc = svcName
                        branches[svc] = {
                            def result = sh(
                                script: "kubectl rollout status deployment/${svc} -n ${env.NAMESPACE} --timeout=${env.ROLLOUT_TIMEOUT}s",
                                returnStatus: true
                            )
                            if (result != 0) {
                                echo "==> DIAGNÓSTICO: deployment/${svc} no llegó a Ready — investigando..."
                                sh(script: "kubectl get pods -n ${env.NAMESPACE} -l app=${svc} -o wide", returnStatus: true)
                                sh(script: "kubectl describe pods -n ${env.NAMESPACE} -l app=${svc} | tail -50", returnStatus: true)
                                sh(script: "kubectl logs -n ${env.NAMESPACE} -l app=${svc} --tail=80 2>/dev/null || true", returnStatus: true)
                                sh(script: "echo '==> Logs del crash anterior (--previous):' && kubectl logs -n ${env.NAMESPACE} -l app=${svc} --previous --tail=100 2>/dev/null || echo 'No hay crash anterior'", returnStatus: true)
                                echo "==> ROLLBACK: deployment/${svc} — revertiendo..."
                                sh(script: "kubectl rollout undo deployment/${svc} -n ${env.NAMESPACE}", returnStatus: true)
                                error("Rollout fallido para: ${svc} — rollback automático aplicado")
                            } else {
                                echo "==> OK: deployment/${svc} desplegado correctamente"
                            }
                        }
                    }

                    parallel branches
                }
            }
        }

        // ── Stage 10: Health Check del Gateway ───────────────────────────────────
        stage('Health Check') {
            steps {
                script {
                    def ip = sh(
                        script: "kubectl get svc gateway-service -n ${env.NAMESPACE} -o jsonpath='{.status.loadBalancer.ingress[0].ip}'",
                        returnStdout: true
                    ).trim()

                    if (!ip) {
                        error("No se pudo obtener la IP del LoadBalancer de gateway-service en ${env.NAMESPACE}")
                    }

                    env.GATEWAY_IP = ip
                    echo "==> Gateway LoadBalancer IP: ${ip}"
                    echo "==> Esperando 90s para que Spring Boot inicialice completamente..."
                    sleep 90

                    def healthy = false
                    for (int i = 1; i <= 24; i++) {
                        def status = sh(
                            script: "curl -sf --max-time 10 http://${ip}:8087/actuator/health || echo 'FAIL'",
                            returnStatus: true
                        )
                        if (status == 0) {
                            echo "==> Health check exitoso en intento ${i}/24"
                            healthy = true
                            break
                        }
                        echo "==> Intento ${i}/24 fallido — esperando 15s..."
                        sleep 15
                    }

                    if (!healthy) {
                        error("Health check fallido tras 24 intentos. Gateway no responde en http://${ip}:8087/actuator/health")
                    }
                }
            }
        }

        // ── Stage 11: Resumen del despliegue ─────────────────────────────────────
        stage('Deployment Summary') {
            steps {
                script {
                    def servicesList = env.SERVICES.tokenize(' ')
                    def imageLines = ''
                    for (int i = 0; i < servicesList.size(); i++) {
                        imageLines += "  - ${ACR_REGISTRY}/circleguard/circleguard-${servicesList[i]}:${params.IMAGE_TAG}\n"
                    }

                    def summary = """\
Deployment Summary — PRODUCTION
=================================
Environment:  ${params.ENVIRONMENT}
Namespace:    ${env.NAMESPACE}
Image tag:    ${params.IMAGE_TAG}
Timestamp:    ${new Date().format('yyyy-MM-dd HH:mm:ss')} UTC
Gateway URL:  http://${env.GATEWAY_IP}:8087

Services deployed:
${imageLines}
Jenkins build: ${env.BUILD_URL}
"""
                    writeFile file: 'deployment-summary.txt', text: summary
                    echo summary
                    sh 'kubectl get pods -n $NAMESPACE'
                    sh 'kubectl get hpa -n $NAMESPACE || true'
                    sh 'kubectl get pdb -n $NAMESPACE || true'
                }
                archiveArtifacts artifacts: 'deployment-summary.txt'
            }
        }
    }

    post {
        success {
            echo "==> Deploy a PRODUCCIÓN exitoso — Gateway: http://${env.GATEWAY_IP ?: 'N/A'}:8087 | Image: ${params.IMAGE_TAG}"
        }
        failure {
            script {
                def servicesList = env.SERVICES.tokenize(' ')
                def rollbackCmds = servicesList.collect { svc ->
                    "  kubectl rollout undo deployment/${svc} -n ${env.NAMESPACE}"
                }.join('\n')
                echo "==> Deploy a PRODUCCIÓN FALLIDO. Rollback manual:\n${rollbackCmds}"
                echo "==> Ver logs: kubectl logs -n ${env.NAMESPACE} deployment/<servicio>"
                echo "==> Estado actual: kubectl get pods -n ${env.NAMESPACE}"
            }
        }
        always {
            cleanWs()
        }
    }
}
